# ============================================================================
# UNOCACE PRODUCCION — plantilla de .env para docker-compose.prod.yml
#
# Copiar al servidor como .env junto al compose, con chmod 600. NUNCA en git.
# Generar cada secreto con: openssl rand -hex 24
#
# Las marcadas [HEREDADO] hay que copiarlas del sistema actual
# (116.203.108.253), no inventarlas: son las que hacen que el correo siga
# saliendo como hoy.
# ============================================================================

# --- Imagen del backend: tag INMUTABLE, nunca `latest` ---
IMAGE_NAME=ghcr.io/atijaguar-ec/backend-inatrace
TAG=

# --- Dominio publico ---
PUBLIC_URL=https://inatrace.unocace.com

# --- PostgreSQL ---
POSTGRES_DB=inatrace_prod_unocace
POSTGRES_USER=inatrace
POSTGRES_PASSWORD=
PG_DATA_VOL=/opt/inatrace/postgresql_data

# --- Keycloak ---
KC_REALM=unocace
KC_DB_NAME=inatrace_keycloak_unocace
# Dejar las dos VACIAS para arrancar con la imagen estandar en start-dev.
# Para modo produccion, publicar antes la imagen optimizada:
#   KC_IMAGE=ghcr.io/atijaguar-ec/keycloak-inatrace:26.0.0-optimized-<sha7>
#   KC_COMMAND=start --optimized
KC_IMAGE=
KC_COMMAND=
# Solo para el primer arranque; retirar del .env una vez creado el admin.
KC_ADMIN_USER=
KC_ADMIN_PASSWORD=
# El mismo valor va en el cliente inatrace-backend del realm.
KC_BACKEND_CLIENT_SECRET=
KC_THEME_VOL=/opt/inatrace/keycloak-theme/inatrace

# --- Correo [HEREDADO: copiar del sistema actual] ---
SPRING_MAIL_HOST=mail.unocace.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=inatrace@unocace.com
SPRING_MAIL_PASSWORD=
SPRING_MAIL_SMTP_AUTH=true
SPRING_MAIL_STARTTLS_ENABLE=true
SPRING_MAIL_SMTP_SSL_ENABLE=false
INATRACE_MAIL_SENDING_ENABLED=true
# En la produccion heredada esta vacio y los correos salen con el remitente por
# defecto. Conviene fijarlo a una direccion institucional antes del corte.
INATRACE_MAIL_TEMPLATE_FROM=
# Para el ensayo: poner una direccion propia aqui desvia TODO el correo a ella.
# Vaciarla antes del corte real.
INATRACE_MAIL_REDIRECT=
# Si se dejan vacias caen al default del compose de staging
# (desarrollo@atijaguar.com). Fijarlas.
INATRACE_LOGINMANAGER_MAIL=inatrace@unocace.com
INATRACE_INFO_MAIL=inatrace@unocace.com

# --- Administrador inicial de INATrace ---
INATRACE_ADMIN_EMAIL=inatrace@unocace.com
INATRACE_ADMIN_PASSWORD=
INATRACE_ADMIN_NAME=Administrador
INATRACE_ADMIN_SURNAME=Unocace
INATRACE_ADMIN_COMPANY_NAME=UNOCACE

# --- Almacenamiento en el host ---
FILE_STORAGE_VOL=/opt/inatrace/uploads
IMPORT_VOL=/opt/inatrace/import
DOCUMENTS_VOL=/opt/inatrace/documents

# --- Flyway ---
# false en produccion. `repair` solo se activa de forma puntual y consciente.
INATRACE_FLYWAY_REPAIR_ON_STARTUP=false

# --- Integraciones (opcionales; vacias = apagadas) ---
# En staging AGSTACK_EMAIL apunta a una cuenta personal del consultor.
# En produccion debe ser institucional.
AGSTACK_EMAIL=
AGSTACK_PASSWORD=
AGSTACK_BASE_URL=
AGSTACK_LOGIN_BASE_URL=
WHISP_API_KEY=
