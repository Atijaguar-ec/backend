POSTGRES_DB=inatrace_unocace_stage
POSTGRES_USER=inatrace
# Generar con: openssl rand -hex 24
POSTGRES_PASSWORD=

KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=

INATRACE_ADMIN_EMAIL=inatrace@unocace.com
INATRACE_ADMIN_PASSWORD=
