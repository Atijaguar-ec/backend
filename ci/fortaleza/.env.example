# ============================================================================
# Fortaleza del Valle — plantilla de .env para backend/ci/fortaleza/docker-compose.yml
# Copiar a `/opt/inatrace/.env` en el servidor (chmod 600, nunca en git).
# ============================================================================

IMAGE_NAME=ghcr.io/atijaguar-ec/backend-inatrace
TAG=staging

DATABASE_NAME=inatrace_fortaleza_stage
DATASOURCE_USERNAME=inatrace
# Generar con: openssl rand -hex 24
DATASOURCE_PASSWORD=
DB_ROOT_PASSWORD=
DB_VOLUME=inatrace_pgdata

KEYCLOAK_HOSTNAME=testinatrace.espam.edu.ec
KC_ADMIN_USER=admin
# Generar contraseña robusta (32+ caracteres) con: openssl rand -base64 32
KC_ADMIN_PASSWORD=
KEYCLOAK_ADMIN_SERVER_URL=http://inatrace-kc-test-fortaleza:8080/auth
KEYCLOAK_ADMIN_REALM=fortaleza
KEYCLOAK_ADMIN_CLIENT_ID=inatrace-backend
KEYCLOAK_CLIENT_SECRET=

FILE_STORAGE_ROOT=/opt/inatrace/file_storage
FILE_STORAGE_ROOT_VOL=./file_storage
IMPORT_PATH=/opt/inatrace/imports
IMPORT_PATH_VOL=./imports
DOCUMENTS_ROOT=/opt/inatrace/documents
DOCUMENTS_ROOT_VOL=./documents

REQUESTLOG_TOKEN=
EXCHANGERATE_APIKEY=
EXCHANGERATE_ENABLED=true
ISSUER_URI=https://testinatrace.espam.edu.ec/auth/realms/fortaleza
