DATASOURCE_USERNAME=inatrace
DATASOURCE_PASSWORD=inatrace

# Keycloak Bootstrap Administrator (Required on first container startup)
KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=admin_dev_password_change_me
